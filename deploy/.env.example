# ===========================================================================
# Gabarit de configuration de production
# ===========================================================================
# À copier en `.env` SUR LE SERVEUR uniquement, puis à compléter.
# Le fichier `.env` réel n'est jamais versionné : il contient des secrets.
#
#   cp .env.example .env
#   chmod 600 .env
#   nano .env

# --- Domaine ---
# Sert à la fois l'origine autorisée du WebSocket et l'adresse du lien d'activation.
DOMAIN=alerte.yannickremy.fr

# --- Base de données ---
POSTGRES_DB=alertmns
POSTGRES_USER=alertmns
# Mot de passe long et aléatoire. Générer avec :  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Provisionnement initial ---
# Appliqué au tout premier démarrage : crée l'organisation, son canal général et
# l'administrateur initial, à qui un lien d'activation est envoyé.
ORGANISATION_NAME=Metz Numeric School
GENERAL_GROUP_NAME=Général
ADMIN_EMAIL=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# --- Version des images déployées ---
# `latest` suit la branche principale. Renseigner une empreinte de commit pour
# figer une version précise ou revenir en arrière :
#   API_TAG=3f2a1c9…
API_TAG=latest
FRONT_TAG=latest
